{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "cortex-debug",
            "servertype": "jlink",
            "request": "launch",
            "name": "N32H473 - J-Link Debug",
            "cwd": "${workspaceRoot}",
            "executable": "${workspaceRoot}/port-n32/build/debug.elf",
            "device": "N32H473CE",
            "interface": "swd",
            "speed": "auto",
            "runToEntryPoint": "main",
            "armToolchainPath": "${env:ARM_GCC_ROOT}/bin/",
            "svdFile": "",
            "preLaunchTask": "",
            "preLaunchCommands": [
                "monitor reset",
                "monitor halt"
            ]
        },
        {
            "type": "cortex-debug",
            "servertype": "jlink",
            "request": "attach",
            "name": "N32H473 - J-Link Attach",
            "cwd": "${workspaceRoot}",
            "executable": "${workspaceRoot}/port-n32/build/debug.elf",
            "device": "N32H473CE",
            "interface": "swd",
            "speed": "auto",
            "armToolchainPath": "${env:ARM_GCC_ROOT}/bin/",
            "svdFile": "",
            "preLaunchTask": ""
        }
    ]
}
